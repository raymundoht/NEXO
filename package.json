{
  "name": "nexo-erp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:production": "node --env-file=.env --import tsx scripts/verify-production.ts",
    "email:test": "node --env-file=.env --import tsx scripts/test-email.ts",
    "admin:credentials": "node --env-file=.env --import tsx scripts/admin-credentials.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^22.4.0",
    "uuid": "^14.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.9",
    "postcss": "8.5.25",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "nanoid": "^5.0.0",
    "brace-expansion": ">=2.0.1"
  }
